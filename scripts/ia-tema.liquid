{% comment %} ===== PHAROL IA · INÍCIO ===== {% endcomment %}
{% if template.name == 'product' %}
<script>
(function () {
  var GEN_PATTERN = /generativelanguage\.googleapis\.com|customily.*(generat|\/ai)/i;
  var ENDPOINT = 'https://gajxzdfcttcocsnjdvha.supabase.co/functions/v1/ia-coleta';
  var DEBUG = /[?&]ai_debug=1/.test(location.search);
  var BASE = {
    shop: {{ shop.permanent_domain | json }},
    host: location.hostname,
    product_id: {{ product.id | json }},
    handle: {{ product.handle | json }}
  };
  var origFetch = window.fetch;

  function send(evento, extra) {
    var body = JSON.stringify(Object.assign({ evento: evento }, BASE, extra || {}));
    if (DEBUG) console.log('[Pharol IA] enviado:', body);
    try {
      origFetch(ENDPOINT, { method: 'POST', body: body, keepalive: true, headers: { 'Content-Type': 'text/plain' } }).catch(function () {});
    } catch (e) {}
  }

  function limpa(url) {
    try { var u = new URL(url, location.href); return u.host + u.pathname; } catch (e) { return String(url).split('?')[0]; }
  }

  var CHAVES = /effect|type|provider|model|prompt|name|style|tool|action|mode|kind/i;
  function assinatura(body) {
    try {
      if (!body) return null;
      var pares = [], chaves = [];
      var add = function (k, v) {
        chaves.push(k);
        if (CHAVES.test(k) && (typeof v === 'string' || typeof v === 'number' || typeof v === 'boolean')) pares.push(k + '=' + String(v).slice(0, 60));
      };
      var anda = function (o, pre, n) {
        if (!o || typeof o !== 'object' || n > 3) return;
        Object.keys(o).forEach(function (k) {
          var v = o[k];
          if (v && typeof v === 'object') anda(v, pre + k + '.', n + 1); else add(pre + k, v);
        });
      };
      if (typeof body === 'string') {
        var j = null;
        try { j = JSON.parse(body); } catch (e) {}
        if (j) anda(j, '', 0); else new URLSearchParams(body).forEach(function (v, k) { add(k, v); });
      } else if (typeof FormData !== 'undefined' && body instanceof FormData) {
        body.forEach(function (v, k) { if (typeof v === 'string') add(k, v); else chaves.push(k + '[arquivo]'); });
      } else if (body instanceof URLSearchParams) {
        body.forEach(function (v, k) { add(k, v); });
      } else {
        return 'corpo:' + (body.constructor && body.constructor.name);
      }
      return (pares.length ? pares.join('&') : 'chaves:' + chaves.slice(0, 25).join(',')).slice(0, 400);
    } catch (e) { return null; }
  }

  function check(url) {
    url = String(url || '');
    if (url.indexOf(ENDPOINT) === 0) return false;
    if (DEBUG && /customily|googleapis/i.test(url)) console.log('[Pharol IA] request:', url);
    return GEN_PATTERN.test(url);
  }

  if (origFetch) {
    window.fetch = function (input, init) {
      var url = typeof input === 'string' ? input : (input && input.url) || '';
      var p = origFetch.apply(this, arguments);
      if (check(url)) {
        var ef = assinatura(init && init.body);
        p.then(function (res) { send('geracao', { status: res.status, ok: res.ok, url: limpa(url), efeito: ef }); })
         .catch(function () { send('geracao', { status: 0, ok: false, url: limpa(url), efeito: ef }); });
      }
      return p;
    };
  }

  var xOpen = XMLHttpRequest.prototype.open;
  var xSend = XMLHttpRequest.prototype.send;
  XMLHttpRequest.prototype.open = function (method, url) {
    this.__phUrl = url;
    return xOpen.apply(this, arguments);
  };
  XMLHttpRequest.prototype.send = function (body) {
    var xhr = this;
    if (check(xhr.__phUrl)) {
      var ef = assinatura(body);
      xhr.addEventListener('loadend', function () {
        send('geracao', { status: xhr.status, ok: xhr.status >= 200 && xhr.status < 300, url: limpa(xhr.__phUrl), efeito: ef });
      });
    }
    return xSend.apply(this, arguments);
  };

  document.addEventListener('change', function (e) {
    var el = e.target;
    if (el && el.matches && el.matches('input[type="file"]') && el.files && el.files.length) send('upload');
  }, true);
})();
</script>
{% endif %}
{% comment %} ===== PHAROL IA · FIM ===== {% endcomment %}
